{
  "name": "thinktree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal agent working-trace panel: see how an agent turns a prompt into an answer.",
  "license": "MIT",
  "homepage": "https://kwong012.github.io/thinktree-web/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwong012/thinktree.git"
  },
  "keywords": [
    "ai-agents",
    "observability",
    "trace",
    "opencode",
    "canvas"
  ],
  "scripts": {
    "start": "node src/server/index.js",
    "demo": "node scripts/demo.mjs",
    "dump": "node scripts/dump-trace.mjs",
    "web:install": "npm --prefix webapp install",
    "dev:web": "npm --prefix webapp run dev",
    "build:web": "npm --prefix webapp run build",
    "test": "node --test test/dashboard-history.test.mjs webapp/test/metrics.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
